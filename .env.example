# --- Chat model: set ONE API key and the provider is detected automatically -------------------
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Optional overrides ----------------------------------------------------------------------
# Pick the model. A provider prefix selects the provider too, e.g.:
#   LLM_MODEL=anthropic:claude-sonnet-5-5
#   LLM_MODEL=openai:<model name>
# Or set the provider separately (google_genai | anthropic | openai | ollama):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1
# LLM_MODEL=gemini-4-hydrogen
# OLLAMA_BASE_URL=http://localhost:11434

# Vision model used once to OCR the image-only peer report (Gemini only, needs GEMINI_API_KEY)
OCR_MODEL=gemini-4-hydrogen

# Audit trace output (optional): TRACE_DIR=traces, TRACE_ENABLED=1
